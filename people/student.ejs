```{=html}
<ul class="roster roster-students">
<% for (const item of items) { %>
  <li>
    <span class="roster-name"><%= item.name %></span>
    <span class="roster-detail"><%= item.type %><span class="roster-sub">Supervised by <%= item.supervisor %></span></span>
    <span class="roster-period"><%= item.period %></span>
  </li>
<% } %>
</ul>
```
