```{=html}
<div class="team-grid list">
<% for (const item of items) {
  const profile = item.web || item.rpweb;
  const initials = item.name.split(/\s+/).filter(w => /^[A-Z]/.test(w)).map(w => w[0]).filter((c, i, a) => i === 0 || i === a.length - 1).join("");
%>
<article class="team-member" <%= metadataAttrs(item) %>>
  <% if (profile) { %><a class="team-photo" href="<%= profile %>" aria-label="<%= item.name %> profile"><% } else { %><div class="team-photo"><% } %>
  <% if (item.image) { %>
    <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
  <% } else { %>
    <span class="team-initials" aria-hidden="true"><%= initials %></span>
  <% } %>
  <% if (profile) { %></a><% } else { %></div><% } %>
  <h3 class="team-name"><%= item.name %></h3>
  <p class="team-role"><%= item.position %></p>
  <% if (item.categories) { %>
  <div class="team-tags">
  <% for (const category of item.categories) { %>
    <% const family = /statist/i.test(category) ? "stats" : /biology/i.test(category) ? "bio" : "computing"; %>
    <div class="listing-category team-tag team-tag-<%= family %>" onclick="window.quartoListingCategory('<%= utils.b64encode(category) %>'); return false;"><%= category %></div>
  <% } %>
  </div>
  <% } %>
  <% if (item['supervisor-primary']) { %>
  <p class="team-note">Primary supervisor: <%= item['supervisor-primary'] %></p>
  <% } %>
  <% if (item['supervisor-associates']) { %>
  <p class="team-note">Associate supervisors: <%= item['supervisor-associates'] %></p>
  <% } %>
  <p class="team-links">
  <% if (item.email) { %><a href="mailto:<%= item.email %>" title="Email" aria-label="Email <%= item.name %>"><i class="bi bi-envelope"></i></a><% } %>
  <% if (item.rpweb) { %><a href="<%= item.rpweb %>" title="ANU research profile" aria-label="<%= item.name %> ANU research profile"><i class="bi bi-person-vcard"></i></a><% } %>
  <% if (item.web) { %><a href="<%= item.web %>" title="Website" aria-label="<%= item.name %> website"><i class="bi bi-globe2"></i></a><% } %>
  <% if (item.github) { %><a href="https://github.com/<%= item.github %>" title="GitHub" aria-label="<%= item.name %> on GitHub"><i class="bi bi-github"></i></a><% } %>
  <% if (item.mastodon) { %><a href="<%= item.mastodon %>" title="Mastodon" aria-label="<%= item.name %> on Mastodon"><i class="bi bi-mastodon"></i></a><% } %>
  <% if (item.bluesky) { %><a href="https://bsky.app/profile/<%= item.bluesky %>" title="Bluesky" aria-label="<%= item.name %> on Bluesky"><i class="bi bi-bluesky"></i></a><% } %>
  </p>
</article>
<% } %>
</div>
```
