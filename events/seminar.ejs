::: {.talk-list}

<% for (const talk of items) { const d = new Date(talk.date); %>
::: {.talk data-date="<%= [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-') %>"}

::: {.talk-when}
[<%= d.getDate() %>]{.talk-day}
[<%= d.toLocaleString('en-AU', { month: 'short' }) %> <%= d.getFullYear() %>]{.talk-month}
<% if (talk.time) { %>[<%= talk.time %>]{.talk-time}<% } %>
:::

::: {.talk-body}
[<%- talk.title %>]{.talk-title}

[<%- talk.speaker %>]{.talk-speaker}, [<%- talk.affiliation %>]{.talk-affil}

<details>
<summary>Abstract<% if (talk.bio) { %> and speaker bio<% } %></summary>

<%- talk.abstract %>

<% if (talk.bio) { %>
**About the speaker**
<%- talk.bio %>
<% } %>

</details>
:::

:::
<% } %>

:::
